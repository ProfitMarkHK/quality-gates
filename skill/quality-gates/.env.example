# Example operator configuration for the optional advisory LLM assessment.
# Copy to `.env` in the invocation configuration directory and fill in real
# values. The real `.env` is local, untracked, and never packaged, logged,
# or sent as target material. Placeholder values below are documentation only.
#
# Approved endpoint reference: Confluence page 214336189
# ("AI Sandbox Internal Tool access"). Coding gateway model GFOX/CA is the
# default worked example; any approved full URL may be configured instead.

# 0 or 1. Unset or 0 means the assessment records `unavailable` (non-blocking).
QUALITY_GATES_LLM_ENABLED=0

# openai or anthropic. Default: openai.
QUALITY_GATES_LLM_API_STYLE=openai

# Complete approved endpoint URL, including sub-path. Adapter appends nothing.
# Documented style defaults: openai -> .../v1/chat/completions,
# anthropic -> .../v1/messages.
QUALITY_GATES_LLM_ENDPOINT=https://llm-gateway.example.invalid/v1/chat/completions

# Approved model identifier. Default: GFOX/CA.
QUALITY_GATES_LLM_MODEL=GFOX/CA

# Optional operator token. Sent as `Authorization: Bearer <token>` when set;
# never logged. Absent means ambient/office-network auth (not a failure).
# QUALITY_GATES_LLM_AUTH_TOKEN=

# Total deadline in seconds for sizing + request + one transient retry.
QUALITY_GATES_LLM_TIMEOUT_SECONDS=60

# Configured output ceiling. Effective budget is dynamic:
# min(MAX_OUTPUT_TOKENS, MAX_MODEL_LEN - input_tokens - 512).
QUALITY_GATES_LLM_MAX_OUTPUT_TOKENS=3000

# Total model context (input + output). Confirmed 393216 for GFOX/CA.
QUALITY_GATES_LLM_MAX_MODEL_LEN=393216

# Cheap local pre-check in bytes; the token budget is authoritative.
QUALITY_GATES_LLM_MAX_INPUT_BYTES=200000

# Transient (429/5xx) retry budget. Default 1, hard-capped at 1. Auth, config,
# validation, malformed-response, and timeout errors are never retried.
QUALITY_GATES_LLM_MAX_RETRIES=1

# Comma-separated host/CIDR entries allowed to serve plain `http://`.
# `https://` endpoints are always allowed (TLS verified, no bypass).
QUALITY_GATES_LLM_HTTP_ALLOWLIST=10.244.0.0/16,127.0.0.1,localhost

# Optional operator-only exclusion globs (repo-relative, comma-separated).
# Matching files are replaced with {readable:false, reason: excluded by operator
# config} placeholders — material_id stays stable so result references still
# validate. Never read from target content; .gitignore and .git/info/exclude
# are never consulted. Matching rules: `*` and `?` stay within one path
# segment, `**` crosses segments, a leading `**/` also matches the top level
# (so `**/*.pyc` matches `a.pyc` and `a/b.pyc`), a trailing `/` matches
# everything under that directory, and a bare name without `/` matches any
# depth by basename (`uv.lock` matches `a/b/uv.lock`). Patterns use posix `/`,
# must stay repo-relative without `..`, and reject control characters.
# Run the seam from a config directory OUTSIDE the target project: a `.env`
# inside the target is refused, never loaded.
# Example: large lockfiles, logs, generated caches that blow the input budget.
# QUALITY_GATES_LLM_EXCLUDE_PATTERNS=uv.lock,config/classification_log.json,**/__pycache__/**,**/*.pyc,.pytest_cache/**,.ruff_cache/**
